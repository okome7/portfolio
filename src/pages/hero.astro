---

---

<section
  id="home"
  class="relative scroll-mt-15 bg-white dark:bg-gray-900 mt-15 flex flex-col md:flex-row items-center px-6 md:px-20 py-8 md:py-0 md:min-h-[calc(100vh-3.75rem)] overflow-hidden"
>
  <!-- 左側 -->
  <div class="md:flex-1 flex flex-col justify-center text-left md:pr-10">
    <!-- メインタイトル -->
    <h1
      class="text-3xl sm:text-4xl md:text-6xl font-semibold text-gray-800 dark:text-gray-100 mb-3 md:mb-4 leading-tight md:leading-snug animate-fadeIn"
    >
      Creating apps with usability in mind.
    </h1>

    <!-- サブタイトル -->
    <p
      class="text-base md:text-xl text-gray-600 dark:text-gray-300 mb-2 md:mb-6 animate-fadeIn delay-200"
    >
      Aspiring Engineer — Yui Kumei
    </p>
  </div>

  <!-- 右側 -->
  <div
    class="md:flex-1 flex justify-center md:justify-end relative mt-3 md:mt-0"
  >
    <!-- パソコン画像 -->
    <img
      src="/portfolio/laptop.png"
      alt="Laptop"
      class="w-52 sm:w-60 md:w-[450px] animate-fadeIn z-10"
    />
  </div>

  <!-- 背景丸デコレーション -->
  <div
    class="absolute -top-24 -left-16 w-64 h-64 bg-linear-to-br from-[#FDE8D0] to-[#F4A259] dark:from-[#4B5563] dark:to-[#1F2937] rounded-full opacity-30 pointer-events-none animate-float"
  >
  </div>
  <div
    class="absolute -bottom-24 -right-16 w-72 h-72 bg-[#F4A259] dark:bg-gray-700 rounded-full opacity-20 pointer-events-none animate-float animation-delay-200"
  >
  </div>
</section>

<style>
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
  }

  .animate-fadeIn {
    animation: fadeIn 1s ease forwards;
  }
  .animate-fadeIn.delay-200 {
    animation-delay: 0.2s;
  }
  .animate-fadeIn.delay-400 {
    animation-delay: 0.4s;
  }

  .animate-float {
    animation: float 6s ease-in-out infinite;
  }
  .animation-delay-200 {
    animation-delay: 0.2s;
  }
</style>
