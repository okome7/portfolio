---
import ProjectCard from "../components/ProjectCard.astro";
---

<section id="projects" class="py-16 px-8 bg-white dark:bg-gray-800">
  <h2 class="text-3xl font-bold mb-6 text-gray-900 dark:text-gray-100">
    Projects
  </h2>
  <div class="space-y-8 md:space-y-20">
    <ProjectCard
      title="OneStep Now"
      tech="Figma（設計） / React, TypeScript, Ruby on Rails, PostgreSQL"
      description="最初の1歩を踏み出しやすくし、他ユーザーからの応援によって行動の継続を促す行動支援アプリ"
      image="/portfolio/screenshots/onestep-home.png"
      link="/portfolio/projects/onestep-now"
      appLink="https://onestep-now-frontend.vercel.app/"
      githubLink="https://github.com/okome7/onestep-now"
      figmaLink="https://www.figma.com/design/Zf5ykRVtIuzeWaEUq7HuA7/OneStep-Now?node-id=0-1&t=J208EluA6z62YqUX-1"
      status="building"
    />

    <ProjectCard
      title="学習ログ"
      tech="Figma（設計） / React, TypeScript, HTML/CSS, LocalStorage"
      description="学んだ内容に焦点を当てて記録できる学習ログアプリ"
      image="/portfolio/screenshots/learning-log-home.png"
      link="/portfolio/projects/learning-log"
      appLink="https://okome7.github.io/learning-log/"
      githubLink="https://github.com/okome7/learning-log"
      figmaLink="https://www.figma.com/design/IcoyvZFKqQaco4Gs8IB9Rb/%E7%84%A1%E9%A1%8C?node-id=0-1&p=f&t=haElZ1nHL8Cea0rr-0"
    />

    <ProjectCard
      title="DelishDays"
      tech="Vue3, Pinia, HTML/CSS, JavaScript, IndexedDB"
      description="自分で作った料理と外食を分けて記録できるアプリ"
      image="/portfolio/screenshots/delishdays-home.png"
      link="/portfolio/projects/delishdays"
      appLink="https://okome7.github.io/delishdays/"
      githubLink="https://github.com/okome7/delishdays"
    />

    <ProjectCard
      title="家計簿"
      tech="HTML/CSS, JavaScript, LocalStorage"
      description="支出・収入をカテゴリごとに分けて管理できる家計簿アプリ"
      image="/portfolio/screenshots/budgeting-home.png"
      link="/portfolio/projects/budgeting-app"
      appLink="https://okome7.github.io/budgeting-app/"
      githubLink="https://github.com/okome7/budgeting-app"
    />
  </div>
</section>
