---
interface ProjectCardProps {
  title: string;
  tech: string;
  description: string;
  image: string;
  link?: string;
  appLink?: string;
  githubLink?: string;
  figmaLink?: string;
  status?: "building";
}

const {
  title,
  tech,
  description,
  image,
  link,
  appLink,
  githubLink,
  figmaLink,
  status,
} = Astro.props as ProjectCardProps;

const isBuilding = status === "building";

const cardClass = isBuilding
  ? "w-full bg-orange-50 dark:bg-orange-900/20 border border-orange-200 dark:border-orange-800 p-6 rounded-lg shadow-md hover:shadow-xl transition-shadow"
  : "w-full bg-white dark:bg-gray-800 p-6 rounded-lg shadow-md hover:shadow-xl transition-shadow";
---

<div class={cardClass} data-aos="fade-up" data-aos-duration="800">
  <div
    class="flex flex-col md:flex-row gap-6 items-center md:items-start w-full"
  >
    <div class="w-full md:w-1/2 flex justify-center">
      <img
        src={image}
        alt={title}
        class="rounded-lg w-[500px] aspect-500/250 object-contain"
      />
    </div>
    <div class="w-full md:w-1/2 flex flex-col justify-between">
      <div>
        {
          isBuilding && (
            <span class="inline-block text-xs font-semibold px-3 py-1 rounded-full bg-orange-500 text-white mb-3">
              実装中
            </span>
          )
        }

        <h3 class="text-xl font-bold mb-2">{title}</h3>
        <p class="text-gray-700 dark:text-gray-300 mb-2">{tech}</p>
        <p class="text-gray-700 dark:text-gray-300 mb-2">{description}</p>
      </div>

      <div class="mt-4 flex flex-wrap gap-3">
        {
          link && (
            <a
              href={link}
              class="inline-flex h-14 min-w-[180px] items-center justify-center rounded-lg bg-[#F4A259] px-5 text-center font-semibold text-white transition-colors hover:bg-[#FFD2A8]"
            >
              詳しく見る
            </a>
          )
        }

        {
          appLink && (
            <a
              href={appLink}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex h-14 min-w-[180px] items-center justify-center rounded-lg bg-[#6C63FF] px-5 text-center font-semibold text-white transition-colors hover:bg-[#9B94FF]"
            >
              アプリを開く
            </a>
          )
        }

        {
          githubLink && (
            <a
              href={githubLink}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex h-14 min-w-[180px] items-center justify-center rounded-lg bg-[#4b5563] px-5 text-center font-semibold text-white transition-colors hover:bg-[#6b7280]"
            >
              GitHubを見る
            </a>
          )
        }

        {
          figmaLink && (
            <a
              href={figmaLink}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex h-14 min-w-[180px] items-center justify-center rounded-lg bg-sky-500 px-5 text-center font-semibold text-white transition-colors hover:bg-sky-400"
            >
              Figmaを見る
            </a>
          )
        }
      </div>
    </div>
  </div>
</div>
